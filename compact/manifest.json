{
  "apiVersion": 2,
  "id": "nimora.compact",
  "name": "Nimora Compact",
  "version": "1.0.16",
  "runtime": "js",
  "description": "A lightweight Nimora bundle with the core movie, TV, anime, sports and LayarKaca providers.",
  "author": "nimbusfvck",
  "entry": "bundle.js",
  "categories": [
    "all",
    "live",
    "sport",
    "movie",
    "tv",
    "anime"
  ],
  "providers": [
    {
      "id": "nimora.matches",
      "name": "Live Sport & Event",
      "roles": ["catalog"],
      "catalogs": [
        {
          "id": "fixtures",
          "name": "Live Sport & Event",
          "categories": ["all", "live", "sport"],
          "kind": "liveEvent",
          "display": "row"
        }
      ]
    },
    {
      "id": "nimora.playz",
      "name": "PlayZTV Live Events",
      "roles": ["stream"]
    },
    {
      "id": "nimora.moviebox",
      "name": "MovieBox",
      "roles": ["stream"]
    },
    {
      "id": "nimora.layarkaca.catalog",
      "name": "LayarKaca",
      "roles": ["meta"],
      "locales": {
        "countries": [
          "ID"
        ],
        "languages": [
          "id"
        ]
      }
    },
    {
      "id": "nimora.layarkaca.hydrax",
      "name": "LayarKaca · HYDRAX",
      "roles": ["stream"],
      "locales": {"countries": ["ID"], "languages": ["id"]}
    },
    {
      "id": "nimora.layarkaca.p2p",
      "name": "LayarKaca · P2P",
      "roles": ["stream"],
      "locales": {"countries": ["ID"], "languages": ["id"]}
    },
    {
      "id": "nimora.layarkaca.turbovip",
      "name": "LayarKaca · TURBOVIP",
      "roles": ["stream"],
      "locales": {"countries": ["ID"], "languages": ["id"]}
    },
    {
      "id": "nimora.layarkaca.cast",
      "name": "LayarKaca · CAST",
      "roles": ["stream"],
      "locales": {"countries": ["ID"], "languages": ["id"]}
    },
    {
      "id": "nimora.tmdb",
      "name": "Movie & Series",
      "roles": ["catalog", "meta", "search"],
      "catalogs": [
        {
          "id": "discover",
          "name": "Movie & Series",
          "categories": ["movie", "tv"],
          "kind": "movie",
          "display": "grid",
          "expanded": true
        },
        {
          "id": "highlights",
          "name": "Movie & Series",
          "categories": ["all"],
          "kind": "movie",
          "display": "row"
        }
      ]
    },
    {
      "id": "nimora.dramadev",
      "name": "Dramadev",
      "roles": ["stream", "meta"]
    },
    {
      "id": "nimora.shorts",
      "name": "Shorts",
      "roles": ["catalog"],
      "catalogs": [
        {
          "id": "shorts",
          "name": "Shorts",
          "categories": [],
          "surface": "preview"
        }
      ]
    },
    {
      "id": "nimora.anilist",
      "name": "Anime Metadata (legacy)",
      "roles": ["meta"]
    },
    {
      "id": "nimora.vidrock",
      "name": "Vidrock",
      "roles": ["stream"]
    },
    {
      "id": "nimora.videasy",
      "name": "Videasy",
      "roles": ["stream"]
    },
    {
      "id": "nimora.vaplayer",
      "name": "VaPlayer",
      "roles": ["stream"]
    },
    {
      "id": "nimora.sokuja",
      "name": "Sokuja",
      "roles": ["catalog", "meta", "search", "stream"],
      "catalogs": [
        {
          "id": "sokuja",
          "name": "Anime",
          "categories": ["anime"],
          "kind": "movie",
          "display": "grid",
          "expanded": true,
          "contentRating": "general"
        }
      ]
    },
    {
      "id": "nimora.shegu",
      "name": "Shegu",
      "roles": ["subtitles"]
    },
    {
      "id": "nimora.skipintro",
      "name": "Skip Intro",
      "roles": ["segments"]
    }
  ],
  "permissions": {"hosts": ["*"]}
}
