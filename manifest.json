{
  "apiVersion": 2,
  "id": "nimora",
  "name": "Nimora",
  "version": "0.6.92",
  "runtime": "js",
  "description": "Live and upcoming sports, movie and TV catalogs, plus anime streams, running as a JavaScript bundle in the sandboxed QuickJS runtime.",
  "author": "nimbusfvck",
  "entry": "bundle.js",
  "categories": [
    "all",
    "live",
    "sport",
    "movie",
    "tv",
    "anime",
    "nsfw"
  ],
  "providers": [
    {
      "id": "nimora.matches",
      "name": "FotMob",
      "roles": [
        "catalog"
      ],
      "catalogs": [
        {
          "id": "fixtures",
          "name": "Nimora",
          "categories": [
            "all",
            "live",
            "sport"
          ],
          "kind": "liveEvent",
          "display": "row"
        }
      ]
    },
    {
      "id": "nimora.timesoccer",
      "name": "Time Soccer TV",
      "roles": [
        "catalog",
        "stream"
      ],
      "catalogs": [
        {
          "id": "timesoccer",
          "name": "Time Soccer TV",
          "categories": [
            "sport"
          ],
          "kind": "movie",
          "display": "row"
        }
      ]
    },
    {
      "id": "nimora.moviebox",
      "name": "MovieBox",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.kora",
      "name": "Kora",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.cricfy",
      "name": "Cricfy",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.metegol",
      "name": "MeteGol",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.tmdb",
      "roles": [
        "catalog",
        "meta",
        "search"
      ],
      "catalogs": [
        {
          "id": "discover",
          "name": "TMDB",
          "categories": [
            "movie",
            "tv"
          ],
          "kind": "movie",
          "display": "grid",
          "expanded": true
        },
        {
          "id": "highlights",
          "name": "TMDB",
          "categories": [
            "all"
          ],
          "kind": "movie",
          "display": "row"
        },
        {
          "id": "previews",
          "name": "Previews",
          "categories": [],
          "surface": "preview"
        }
      ]
    },
    {
      "id": "nimora.anilist",
      "name": "AniList",
      "roles": [
        "catalog",
        "meta",
        "search"
      ],
      "catalogs": [
        {
          "id": "anilist",
          "name": "AniList Anime",
          "categories": [
            "anime"
          ],
          "kind": "movie",
          "display": "grid",
          "expanded": true,
          "contentRating": "general"
        }
      ]
    },
    {
      "id": "nimora.flystream",
      "name": "FlyStream",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.vidrock",
      "name": "Vidrock",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.videasy",
      "name": "Videasy",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.vaplayer",
      "name": "VaPlayer",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.sokuja",
      "name": "Sokuja",
      "roles": [
        "stream"
      ]
    },
    {
      "id": "nimora.indomax",
      "name": "Indomax",
      "roles": [
        "stream",
        "search",
        "catalog",
        "meta"
      ],
      "catalogs": [
        {
          "id": "nsfw",
          "name": "Indomax 18+",
          "categories": [
            "nsfw"
          ],
          "kind": "movie",
          "display": "row",
          "contentRating": "mature"
        }
      ]
    },
    {
      "id": "nimora.shegu",
      "name": "Shegu",
      "roles": [
        "subtitles"
      ]
    },
    {
      "id": "nimora.skipintro",
      "name": "Skip Intro",
      "roles": [
        "segments"
      ]
    }
  ],
  "permissions": {
    "hosts": [
      "*"
    ]
  }
}
